begin defs       ; dimension of data array [sx,sy] \n\
 dim s[256]      ;  for set-up \n\
 dim1 s[300]    ;  for fieldsweep \n\
 dim2 s[1024]   ;  for echo decay \n\
 dim3 s[1024,80]   ;  for single shot echo decay \n\
 dim4 s[512,128] ;  for echo decay vs. field \n\
 dim5 s[128]     ;  for T1 inversion recovery measurement \n\
 dim6 s[100]     ;  for Rabi oscillations \n\
 dim7 s[20]      ;  for CPMG/XYXY setup \n\
 dim8 s[50]      ;  for CPMG/XYXY run \n\
 dim9 s[25]      ;  for XY-16 \n\
end defs \n\
; \n\
; \n\
begin lists "none" \n\
 ph1 +x \n\
 ph2 +x \n\
 asg1 +a \n\
 bsg1 +b \n\
end lists \n\
 \n\
begin lists1 "2-step" \n\
 ph1 +x -x \n\
 ph2 +x +x \n\
 asg1 +a -a \n\
 bsg1 +b -b \n\
end lists1 \n\
 \n\
begin lists2 "16-step" \n\
 ph1 +x -x +y -y  +x -x +y -y \n\
 ph2 +x -x +y -y  -x +x -y +y  +y -y -x +x  -y +y +x -x \n\
 asg1 +a -a +b -b  +a -a +b -b  -a +a -b +b  -a +a -b +b \n\
 bsg1 +b -b -a +a  +b -b -a +a  -b +b +a -a  -b +b +a -a \n\
end lists2 \n\
 \n\
begin lists3 "CPMG" \n\
  ph1 +x \n\
  ph2 +y \n\
  ph3 +y \n\
  asg1 -a \n\
  bsg1 -b \n\
end lists3 \n\
 \n\
begin lists4 "XYXY" \n\
  ph1 +x \n\
  ph2 +y \n\
  ph3 +x \n\
  asg1 -a \n\
  bsg1 -b \n\
end lists4 \n\
 \n\
begin lists5 "XY-16" \n\
  ph1 +x \n\
  asg1 -a \n\
  bsg1 -b \n\
end lists5 \n\
 \n\
; \n\
; Standing Echo for 2-Pulse Set-Up \n\
; \n\
begin exp "2P ESE Setup" [TRANS QUAD Lists Lists1 Lists2] \n\
; QUAD detection of Transient \n\
 \n\
 \n\
   shot i=1 to a                ; accumulation loop \n\
    d9                          ; DAF (Delay After Flash) \n\
    p0 [ph1]                    ; 1st pulse and phase program \n\
    d1                          ; tau \n\
    p1 [ph2]                    ; 2nd pulse and phase program \n\
    d1                          ; tau \n\
    d0                          ; acquistion delay \n\
    dig [sg1]                   ; acquisition \n\
   next i                       ; end of accumulation loop \n\
 \n\
end exp \n\
 \n\
; \n\
; 2-Pulse Field Sweep \n\
; \n\
begin exp1 "2P ESE Field Sweep" [INTG QUAD Lists Lists1 Lists2] \n\
; QUAD detection with Integration \n\
 \n\
 for k=1 to n                   ; averaging loop \n\
  totscans(n)                   ; output of total number of scans \n\
 \n\
  bsweep x=1 to sx              ; field sweep loop \n\
   shot i=1 to h                ; accumulation loop \n\
    d9                          ; DAF (Delay After Flash) \n\
    p0 [ph1]                    ; 1st pulse and phase program \n\
    d1                          ; tau \n\
    p1 [ph2]                    ; 2nd pulse and phase program \n\
    d1                          ; tau \n\
    d0                          ; constant acquisition delay \n\
    acq [sg1]                   ; acquisition \n\
   next i                       ; end of accumulation loop \n\
 \n\
  next x                        ; end of field sweep loop \n\
 \n\
  scansdone(k)                  ; output of scans done \n\
 next k                         ; end of averaging loop \n\
 \n\
end exp1 \n\
 \n\
; \n\
; 2-Pulse Echo Decay \n\
; \n\
begin exp2 "2P ESE Decay" [INTG QUAD Lists Lists1 Lists2] \n\
; QUAD detection with Integration \n\
 \n\
d2=d1                           ; store starting tau value \n\
 \n\
  d1=d2                        ; recall starting tau value \n\
  dx=d1                        ; starting tau and assignment of x-axis \n\
 \n\
  sweep x=1 to sx               ; tau sweep loop \n\
    shot i=1 to h                ; accumulation loop \n\
      d9                          ; DAF (Delay After Flash) \n\
      p0 [ph1]                     ; 1st pulse and phase program \n\
      d1                          ; tau \n\
      p1 [ph2]                     ; 2nd pulse and phase program \n\
      d1                          ; tau \n\
      d0                          ; constant acquisition delay \n\
      acq [sg1]                   ; acquisition \n\
     next i                       ; end of accumulation loop \n\
 \n\
    d1=d1+d30 \n\
    dx=dx+d30                    ; x-axis measured from first pulse \n\
    dx=dx+d30 \n\
    next x                        ; end of tau sweep loop \n\
 \n\
end exp2 \n\
 \n\
; \n\
; Single Shot 2-Pulse Echo Decay \n\
; \n\
begin exp3 "2P ESE Decay Single Shot" [INTG QUAD Lists] \n\
; QUAD detection with Integration \n\
 \n\
d2=d1                           ; store starting tau value \n\
 \n\
  totscans(n)                   ; output of total number of scans \n\
  y = 1 \n\
 \n\
  for y=1 to sy \n\
 \n\
    d1=d2                        ; recall starting tau value \n\
    dx=d1                        ; starting tau and assignment of x-axis \n\
 \n\
    sweep x=1 to sx               ; tau sweep loop \n\
      shot i=1 to 1                ; accumulation loop \n\
        d9                          ; DAF (Delay After Flash) \n\
        p0 [+x]                     ; 1st pulse and phase program \n\
        d1                          ; tau \n\
        p1 [+x]                     ; 2nd pulse and phase program \n\
        d1                          ; tau \n\
        d0                          ; constant acquisition delay \n\
        acq [sg1]                   ; acquisition \n\
       next i                       ; end of accumulation loop \n\
 \n\
      d1=d1+d30 \n\
      dx=dx+d30                    ; x-axis measured from first pulse \n\
      dx=dx+d30 \n\
    next x                        ; end of tau sweep loop \n\
  next y \n\
 \n\
end exp3 \n\
 \n\
; \n\
; 2-Pulse Echo Decay versus Magnetic Field \n\
; \n\
begin exp4 "2P ESE Decay vs. B0" [INTG QUAD Lists Lists1 Lists2] \n\
; QUAD detection with Integration \n\
 \n\
d2=d1                           ; store starting tau value \n\
 \n\
 for k=1 to n                   ; averaging loop \n\
  totscans(n)                   ; output of total number of scans \n\
 \n\
  bsweep y=1 to sy              ; field sweep loop \n\
    d1=d2                       ; recall starting tau value \n\
    dx=d1                       ; starting tau and assignment of x-axis \n\
 \n\
  sweep x=1 to sx               ; tau sweep loop \n\
   shot i=1 to h                ; accumulation loop \n\
    d9                          ; DAF (Delay After Flash) \n\
    p0 [ph1]                    ; 1st pulse and phase program \n\
    d1                          ; tau \n\
    p1 [ph2]                    ; 2nd pulse and phase program \n\
    d1                          ; tau \n\
    d0                          ; constant acquisition delay \n\
    acq [sg1]                   ; acquisition \n\
   next i                       ; end of accumulation loop \n\
 \n\
   d1=d1+d30 \n\
   dx=dx+d30                    ; x-axis defined from first pulse \n\
   dx=dx+d30                    ; \n\
  next x                        ; end of tau sweep loop \n\
 \n\
 next y                         ; end of field sweep loop \n\
 \n\
  scansdone(k)                  ; output of scans done \n\
 next k                         ; end of averaging loop \n\
 \n\
end exp4 \n\
 \n\
; \n\
; T1 by inversion recovery \n\
; \n\
begin exp5 "T1 by Inv Rec" [INTG QUAD Lists Lists1 Lists2] \n\
; QUAD detection with Integration \n\
 \n\
d2=d3                           ; store starting tau value \n\
 \n\
 for k=1 to n                   ; averaging loop \n\
  totscans(n)                   ; output of total number of scans \n\
 \n\
   d3=d2                        ; recall starting tau value \n\
   dx=d3                        ; starting tau and assignment of x-axis \n\
 \n\
  sweep x=1 to sx               ; tau sweep loop \n\
   shot i=1 to h                ; accumulation loop \n\
    d9                          ; 'Delay after flash' \n\
    p1 [+x]                     ; Inversion pulse \n\
    d3 \n\
    p0 [ph1]                    ; 1st pulse and phase program \n\
    d1                          ; tau \n\
    p1 [ph2]                    ; 2nd pulse and phase program \n\
    d1                          ; tau \n\
    d0                          ; constant acquisition delay \n\
    acq [sg1]                   ; acquisition \n\
   next i                       ; end of accumulation loop \n\
 \n\
   d3=d3+d31 \n\
   dx=dx+d31                    ; x-axis measured from first pulse \n\
   next x                       ; end of tau sweep loop \n\
 \n\
  scansdone(k)                  ; output of scans done \n\
 next k                         ; end of averaging loop \n\
 \n\
end exp5 \n\
 \n\
; \n\
; ESE Detected Nutations (Rabi Oscillations) \n\
; \n\
begin exp6 "ESE Rabi-Oscillations" [INTG QUAD Lists Lists1 Lists2] \n\
; QUAD detection with Integration \n\
 \n\
p4=p3                           ; store original pulse length \n\
 \n\
 for k=1 to n                   ; averaging loop \n\
  totscans(n)                   ; output total number of scans \n\
 \n\
  p3=p4                         ; recall original pulse length \n\
  dx=p3                         ; define x-axis \n\
 \n\
  sweep x=1 to sx               ; pulse increment loop \n\
   shot i=1 to h                ; accumulation loop \n\
    d9                          ; DAF (Delay After Flash) \n\
    p3 [ph1]                    ; nutation pulse (incremented) \n\
    dx                          ; delay during nutation pulse (incremented) \n\
    d1                          ; tau \n\
    p1 [ph2]                    ; 180 pulse \n\
    d1                          ; tau \n\
    d0                          ; constant acquisition delay \n\
    acq [sg1]                   ; acquisition \n\
   next i                       ; end of accumulation loop \n\
 \n\
   p3=p3+d29                    ; increment pulse length \n\
   dx=dx+d29                    ; increment axis \n\
  next x                        ; end of pulse loop \n\
 \n\
  scansdone(k)                  ; output number of scans completed \n\
 next k                         ; end of averaging loop \n\
 \n\
end exp6 \n\
 \n\
; Carr Purcell Gill Meiboom \n\
; \n\
begin exp7 "CPGM/XYXY SetUp" [TRANS QUAD Lists3 Lists4] \n\
; QUAD detection of Transient \n\
 \n\
d0=d0-20 \n\
r = 1 \n\
   shot i=1 to a		; accumulation loop \n\
    p0 [ph1]			; 1st 90 degree pulse     \n\
     \n\
    for j=1 to r		; 180 pulse loop \n\
      d1			; 2*tau \n\
      p1 [ph2]			; 180 pulses \n\
      d1 \n\
      d1			; 2*tau \n\
      p1 [ph3]			; 180 pulses \n\
      d1 \n\
    next j			; end of 180 pulse loop \n\
 \n\
    d0 \n\
    dig [sg1]			; acquisition \n\
   next i			; end of accumulation loop \n\
 \n\
end exp7 \n\
 \n\
; \n\
; Carr Purcell Gill Meiboom \n\
; \n\
begin exp8 "CPGM/XYXY Run" [INTG QUAD Lists3 Lists4] \n\
; QUAD detection of Transient \n\
 \n\
d8=d2*r \n\
d0=d0-20 \n\
r=1 \n\
d4=d1*l \n\
d4=d4*4 \n\
dx=d4 \n\
    \n\
  for x=1 to sx \n\
  shot i=1 to a		; accumulation loop \n\
    p0 [ph1]			; 1st 90 degree pulse     \n\
     \n\
    for j=1 to r		; 180 pulse loop \n\
      d1			; 2*tau \n\
      p1 [ph2]			; 180 pulses \n\
      d1 \n\
      d1			; 2*tau \n\
      p1 [ph3]			; 180 pulses \n\
      d1 \n\
    next j			; end of 180 pulse loop \n\
 \n\
    d0 \n\
    acq [sg1]			; acquisition \n\
   next i			; end of accumulation loop \n\
   \n\
  r=r+l \n\
  dx=dx+d4 \n\
  next x \n\
 \n\
end exp8 \n\
 \n\
; \n\
; XYXYYXYX-(YXYXXYXY) \n\
; \n\
begin exp9 "XY-16" [INTG QUAD Lists5] \n\
; QUAD detection of Transient  \n\
 \n\
d8 = d2*r \n\
d0 = d0-20 \n\
r = l \n\
d4 = d1*l \n\
d4 = d4*16 \n\
dx = d4 \n\
    \n\
  for x=1 to sx \n\
    shot i=1 to a		; accumulation loop \n\
      p0 [ph1]			; 1st 90 degree pulse     \n\
     \n\
      for j=1 to r		; 180 pulse loop \n\
        d1			; 2*tau \n\
        p1 [+x] \n\
        d1 \n\
        d1 \n\
        p1 [+y] \n\
        d1 \n\
        d1 \n\
        p1 [+x] \n\
        d1 \n\
        d1 \n\
        p1 [+y] \n\
        d1 \n\
        d1 \n\
        p1 [+y] \n\
        d1 \n\
        d1 \n\
        p1 [+x] \n\
        d1 \n\
        d1 \n\
        p1 [+y] \n\
        d1 \n\
        d1 \n\
        p1 [+x] \n\
        d1 \n\
        d1 \n\
        p1 [-x] \n\
        d1 \n\
        d1 \n\
        p1 [-y] \n\
        d1 \n\
        d1 \n\
        p1 [-x] \n\
        d1 \n\
        d1 \n\
        p1 [-y] \n\
        d1 \n\
        d1 \n\
        p1 [-y] \n\
        d1 \n\
        d1 \n\
        p1 [-x] \n\
        d1 \n\
        d1 \n\
        p1 [-y] \n\
        d1 \n\
        d1 \n\
        p1 [-x] \n\
        d1 \n\
      next j			; end of 180 pulse loop \n\
 \n\
      d0 \n\
      acq [sg1]			; acquisition \n\
    next i			; end of accumulation loop \n\
 \n\
    r=r+l \n\
    dx=dx+d4 \n\
  next x \n\
 \n\
end exp9\n
