;     PulseSPEL general variables, definitions & convention\n\
\n\
\n\
\n\
begin defs\n\
;                                               \n\
;\n\
;                                                         Feb. 2000, PEH\n\
; Variables     ; Comments:\n\
                        ;\n\
p0   = 16      ; 90 pulse length\n\
p1   = 32      ;180 pulse length \n\
p2   = 32      ;\n\
p3   = 40      ;\n\
p7   = 80      ; LeCroy trigger\n\
p9   = 1000    \n\
pg   = 140     ; Intergrator Gate Width\n\
                        ;\n\
d0   = 400     ; data trigger offset time\n\
d1   = 400     ; Initial delay between the first two pulses\n\
d2   = 400     ; Initial delay between the second and third pulses\n\
d3   = 100     ; Initial delay between the third and fourth pulses\n\
d4   = 10      ;\n\
d5   = 400     ;\n\
                        ;\n\
dx   = 0       ; t2 time scale starting value\n\
dy   = 0       ; t1 time scale starting value\n\
               ;\n\
d30  = 300     ; t2 time scale increment\n\
d31  = 4       ; t1 time scale increment\n\
d20  = 0       ; Initial value of dx\n\
d21  = 0       ; Initial value of dy\n\
                        ;\n\
h    = 80      ; number of shots/loop                     ( counter: I )\n\
n    = 1       ; number of sweeps to accumulate           ( counter: K )\n\
s    = 300     ; Sweep length (n. of data really taken)   ( counter: X )\n\
t    = 1       ; second time axsis sweep length           ( counter: Y )\n\
m    = 28      ;\n\
              ;\n\
srt  = 5000 * srtu ; shot repetition time, srtu=1usec\n\
r    = 1       ;\n\
c    = 1       ;\n\
b    = 1       ;\n\
             ;\n\
w    = 800     ; Split point of sweeps (ns) ,i.e. pulse separatrion where\n\
             ; TWT gate pulse can be split.\n\
;\n\
p8   = 0 ns    \n\
a    = 1       \n\
end defs\n\
\n
PlsSPELLISTSlct    none
PlsSPELPhPrgEx     Normal
PlsSPELPrg         Achuthan/PulsepelAchuthan.exp
